# Cloud secret template. Copy to .env.modal, fill in values, and keep that file private.
# Do not add ABTRACT_DATA_DIR: the Modal image already points it at the /data Volume.
MODAL_PROXY_TOKEN=
MODAL_INFERENCE_BASE_URL=https://inference.us-west.modal.direct/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Required for the hosted product. Username: abtract.
ABTRACT_DASHBOARD_PASSWORD=

# Internal per-job agent-token allowance; excludes helper inference and compute.
ABTRACT_JOB_SWARM_BUDGET_USD=5

# Optional model name overrides from your Shared Endpoint's API example:
# ABTRACT_MODEL_DEEPSEEK_V4_1_FLASH=
# ABTRACT_MODEL_GLM_5_3_FLASH=
# ABTRACT_SITE_BASE_URL=https://YOUR-SITE-ENDPOINT.modal.run
