# Modal hosted inference (OpenAI-compatible). Create with: modal workspace proxy-tokens create
MODAL_PROXY_TOKEN=
MODAL_INFERENCE_BASE_URL=https://inference.us-west.modal.direct/v1

# Optional overrides for the OpenAI `model` field per swarm model (ABTRACT_MODEL_<ID>, id upper-cased, "."/"-" -> "_").
# Defaults are the Modal library IDs from apps/api/app/models/pricing.py (deepseek-ai/DeepSeek-V4.1-Flash, ...), and at
# first use each is matched against GET /v1/models for your token (library ID or endpoint hostname, e.g.
# deepseek-v4-1-flash.us-west.modal.direct). Only set one if `cd apps/api && uv run python scripts/list_models.py` shows the wrong
# match. Blank = default.
ABTRACT_MODEL_DEEPSEEK_V4_1_FLASH=
ABTRACT_MODEL_GLM_5_3_FLASH=
ABTRACT_MODEL_INKLING=
ABTRACT_MODEL_GLM_5_3=
ABTRACT_MODEL_QWEN3_8_MAX=
ABTRACT_MODEL_KIMI_K3=

# Gemini (site optimizer + task generator + judge)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set to mock for offline loop testing; leave blank to use Gemini for real rewrites.
ABTRACT_OPTIMIZER_MODEL=

# Optional locally; required for Modal hosting. Username: abtract.
ABTRACT_DASHBOARD_PASSWORD=

# Internal per-product-job agent-token allowance (not a total provider billing cap).
ABTRACT_JOB_SWARM_BUDGET_USD=5

# Where results live. On Modal this is the mounted Volume (/data). Locally it defaults to ./data
ABTRACT_DATA_DIR=./data

# Public base URL of the deployed site-hosting endpoint (filled in after `mise run modal:deploy`)
ABTRACT_SITE_BASE_URL=
